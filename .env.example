# ==============================================================================
# SCHOOL ERP SAAS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / Mac:        cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR '.env' TO GIT!
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Application Authentication Secrets
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_64_character_jwt_secret_here

# SaaS Multi-Tenant Domain Configuration
# The root apex domain used by your SaaS platform (e.g., schoolerp.in, mydomain.com)
SAAS_BASE_DOMAIN=schoolerp.in

# Vercel Deployment Targets for Custom Domain DNS Routing
# Actual Vercel Anycast IP and CNAME target for your deployment
VERCEL_IP=76.76.21.21
VERCEL_CNAME=cname.vercel-dns.com

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# Found in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Safe for browser / public use)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (SERVER-ONLY — NEVER EXPOSE TO BROWSER / GIT)
# Grants server-side administrative access bypassing Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase PostgreSQL Direct / Transaction Pooler Connection URL (Optional)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (Meta WhatsApp Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
